# Copy this file to .env.local and fill in values from YOUR hoglab project
# (Lab 00 walks you through creating it). .env.local is gitignored.

# Project API key — Settings → Project → General. Public by design:
# it can only ingest events, never read data. The NEXT_PUBLIC_ prefix
# is what makes Next.js expose it to the browser (Lab 01).
NEXT_PUBLIC_POSTHOG_KEY=phc_YOUR_PROJECT_API_KEY

# Match the region you chose in Lab 00: US or EU. This is the api_host
# your events are sent to — remember it, it comes back in drill 11.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Personal API key — needed for server-side local flag evaluation (Lab 05).
# Create one at Settings → User → Personal API keys, scope: feature flags read.
# SERVER-ONLY SECRET. It must NEVER get a NEXT_PUBLIC_ prefix — that would
# ship it to every visitor's browser (drill 12 shows you what that looks like).
POSTHOG_PERSONAL_API_KEY=phx_YOUR_PERSONAL_API_KEY
